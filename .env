# ==============================
# APPLICATION CONFIGURATION
# ==============================
SPRING_APPLICATION_NAME=architect

# ==============================
# DATABASE CONFIGURATION
# ==============================
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:9090/architecture?useSSL=false
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=1422

# ==============================
# JPA CONFIGURATION
# ==============================
SPRING_JPA_OPEN_IN_VIEW=false
SPRING_JPA_SHOW_SQL=true
SPRING_JPA_HIBERNATE_DDL_AUTO=validate
SPRING_JPA_PROPERTIES_HIBERNATE_FORMAT_SQL=true

# ==============================
# FLYWAY CONFIGURATION
# ==============================
SPRING_FLYWAY_ENABLED=true
SPRING_FLYWAY_LOCATIONS=classpath:db/migration
SPRING_FLYWAY_BASELINE_ON_MIGRATE=true
SPRING_FLYWAY_OUT_OF_ORDER=false

# ==============================
# JWT CONFIGURATION
# ==============================
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION=3600000
JWT_REFRESH_EXPIRATION=86400000

# ==============================
# SWAGGER CONFIGURATION
# ==============================
SPRINGDOC_API_DOCS_ENABLED=true
SPRINGDOC_SWAGGER_UI_ENABLED=true

# ==============================
# CORS CONFIGURATION
# ==============================
APP_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:4200,http://localhost:5173,http://192.168.11.4:5173

# ==============================
# DEFAULT ADMIN CONFIGURATION
# ==============================
APP_DEFAULT_ADMIN_EMAIL=admin@architect.com
APP_DEFAULT_ADMIN_PASSWORD=Admin@123
APP_DEFAULT_ADMIN_PHONE=0000000000

# ==============================
# COMPANY CONFIGURATION
# ==============================
APP_COMPANY_NAME=Architect Project Management
APP_COMPANY_ADDRESS=Sangli, Maharashtra